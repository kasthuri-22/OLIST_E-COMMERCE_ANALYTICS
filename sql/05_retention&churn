/* ============================================================
   Q1. What percentage of customers make repeat purchases?
   ============================================================ */

SELECT
    CASE
        WHEN order_count = 1 THEN 'One-time Customer'
        ELSE 'Repeat Customer'
    END AS customer_type,
    COUNT(*) AS customers,
    ROUND(
        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (),
        2
    ) AS customer_percentage
FROM (
    SELECT
        c.customer_unique_id,
        COUNT(DISTINCT o.order_id) AS order_count
    FROM raw_orders o
    JOIN raw_customers c
        ON o.customer_id = c.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY c.customer_unique_id
) customer_orders
GROUP BY
    CASE
        WHEN order_count = 1 THEN 'One-time Customer'
        ELSE 'Repeat Customer'
    END;


/*
KEY INSIGHT:
- 90,557 customers made only one purchase.
- 2,801 customers made repeat purchases.
- Overall repeat purchase rate was approximately 3%.
- Around 97% of customers were one-time customers.

BUSINESS INTERPRETATION:
Customer repeat purchasing was relatively low in the observed
dataset, indicating that most customers did not return for another
delivered purchase.
*/


/* ============================================================
   Q2. How long does it take customers to make another purchase?
   ============================================================ */

WITH customer_orders AS (
    SELECT
        c.customer_unique_id,
        o.order_id,
        o.order_purchase_timestamp AS purchase_date
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
),

purchase_gaps AS (
    SELECT
        customer_unique_id,
        order_id,
        purchase_date,
        LAG(purchase_date) OVER (
            PARTITION BY customer_unique_id
            ORDER BY purchase_date
        ) AS previous_purchase_date
    FROM customer_orders
)

SELECT
    ROUND(
        AVG(
            DATEDIFF(
                purchase_date,
                previous_purchase_date
            )
        ),
        2
    ) AS avg_days_to_repeat
FROM purchase_gaps
WHERE previous_purchase_date IS NOT NULL;


/*
KEY INSIGHT:
- Average gap between consecutive delivered purchases was
  approximately 79.15 days.

BUSINESS INTERPRETATION:
Among customers who returned, the average time between consecutive
delivered purchases was approximately 79 days (around 2.6 months).

NOTE:
This does NOT mean customers churn after 79 days. It represents
the average purchase gap among customers who actually returned.
*/


/* ============================================================
   Q3. COHORT RETENTION ANALYSIS
   ============================================================ */


/* ------------------------------------------------------------
   Step 1: Identify each customer's first delivered purchase month
   ------------------------------------------------------------ */

WITH customer_cohorts AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            MIN(o.order_purchase_timestamp),
            '%Y-%m-01'
        ) AS cohort_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY c.customer_unique_id
)

SELECT *
FROM customer_cohorts
ORDER BY cohort_month;


/* ------------------------------------------------------------
   Step 2: Attach cohort month to every delivered purchase
   ------------------------------------------------------------ */

WITH customer_cohorts AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            MIN(o.order_purchase_timestamp),
            '%Y-%m-01'
        ) AS cohort_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY c.customer_unique_id
),

customer_purchases AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            o.order_purchase_timestamp,
            '%Y-%m-01'
        ) AS purchase_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
)

SELECT
    cp.customer_unique_id,
    cc.cohort_month,
    cp.purchase_month
FROM customer_purchases cp
JOIN customer_cohorts cc
    ON cp.customer_unique_id = cc.customer_unique_id
ORDER BY
    cp.customer_unique_id,
    cp.purchase_month;


/* ------------------------------------------------------------
   Step 3: Calculate months since cohort
   ------------------------------------------------------------ */

WITH customer_cohorts AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            MIN(o.order_purchase_timestamp),
            '%Y-%m-01'
        ) AS cohort_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY c.customer_unique_id
),

customer_purchases AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            o.order_purchase_timestamp,
            '%Y-%m-01'
        ) AS purchase_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
)

SELECT
    cp.customer_unique_id,
    cc.cohort_month,
    cp.purchase_month,
    TIMESTAMPDIFF(
        MONTH,
        cc.cohort_month,
        cp.purchase_month
    ) AS months_since_cohort
FROM customer_purchases cp
JOIN customer_cohorts cc
    ON cp.customer_unique_id = cc.customer_unique_id
ORDER BY
    cp.customer_unique_id,
    cp.purchase_month;


/* ------------------------------------------------------------
   Step 4: Calculate active customers by cohort and month
   ------------------------------------------------------------ */

WITH customer_cohorts AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            MIN(o.order_purchase_timestamp),
            '%Y-%m-01'
        ) AS cohort_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY c.customer_unique_id
),

customer_purchases AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            o.order_purchase_timestamp,
            '%Y-%m-01'
        ) AS purchase_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
),

customer_activity AS (
    SELECT
        cp.customer_unique_id,
        cc.cohort_month,
        cp.purchase_month,
        TIMESTAMPDIFF(
            MONTH,
            cc.cohort_month,
            cp.purchase_month
        ) AS months_since_cohort
    FROM customer_purchases cp
    JOIN customer_cohorts cc
        ON cp.customer_unique_id = cc.customer_unique_id
)

SELECT
    cohort_month,
    months_since_cohort,
    COUNT(DISTINCT customer_unique_id) AS active_customers
FROM customer_activity
GROUP BY
    cohort_month,
    months_since_cohort
ORDER BY
    cohort_month,
    months_since_cohort;


/* ------------------------------------------------------------
   Step 5: Calculate cohort retention rate
   ------------------------------------------------------------ */

WITH customer_cohorts AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            MIN(o.order_purchase_timestamp),
            '%Y-%m-01'
        ) AS cohort_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY c.customer_unique_id
),

customer_purchases AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            o.order_purchase_timestamp,
            '%Y-%m-01'
        ) AS purchase_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
),

customer_activity AS (
    SELECT
        cp.customer_unique_id,
        cc.cohort_month,
        cp.purchase_month,
        TIMESTAMPDIFF(
            MONTH,
            cc.cohort_month,
            cp.purchase_month
        ) AS months_since_cohort
    FROM customer_purchases cp
    JOIN customer_cohorts cc
        ON cp.customer_unique_id = cc.customer_unique_id
),

cohort_counts AS (
    SELECT
        cohort_month,
        months_since_cohort,
        COUNT(DISTINCT customer_unique_id) AS active_customers
    FROM customer_activity
    GROUP BY
        cohort_month,
        months_since_cohort
),

cohort_retention AS (
    SELECT
        cohort_month,
        months_since_cohort,
        active_customers,
        FIRST_VALUE(active_customers) OVER (
            PARTITION BY cohort_month
            ORDER BY months_since_cohort
        ) AS cohort_size
    FROM cohort_counts
)

SELECT
    cohort_month,
    months_since_cohort,
    active_customers,
    cohort_size,
    ROUND(
        active_customers * 100.0 / cohort_size,
        2
    ) AS retention_rate
FROM cohort_retention
ORDER BY
    cohort_month,
    months_since_cohort;


/* ------------------------------------------------------------
   Step 6: Cohort Retention Matrix
   ------------------------------------------------------------ */

WITH customer_cohorts AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            MIN(o.order_purchase_timestamp),
            '%Y-%m-01'
        ) AS cohort_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
    GROUP BY c.customer_unique_id
),

customer_purchases AS (
    SELECT
        c.customer_unique_id,
        DATE_FORMAT(
            o.order_purchase_timestamp,
            '%Y-%m-01'
        ) AS purchase_month
    FROM raw_customers c
    JOIN raw_orders o
        ON c.customer_id = o.customer_id
    WHERE o.order_status = 'delivered'
),

customer_activity AS (
    SELECT
        cp.customer_unique_id,
        cc.cohort_month,
        cp.purchase_month,
        TIMESTAMPDIFF(
            MONTH,
            cc.cohort_month,
            cp.purchase_month
        ) AS months_since_cohort
    FROM customer_purchases cp
    JOIN customer_cohorts cc
        ON cp.customer_unique_id = cc.customer_unique_id
),

cohort_counts AS (
    SELECT
        cohort_month,
        months_since_cohort,
        COUNT(DISTINCT customer_unique_id) AS active_customers
    FROM customer_activity
    GROUP BY
        cohort_month,
        months_since_cohort
),

cohort_retention AS (
    SELECT
        cohort_month,
        months_since_cohort,
        active_customers,
        FIRST_VALUE(active_customers) OVER (
            PARTITION BY cohort_month
            ORDER BY months_since_cohort
        ) AS cohort_size
    FROM cohort_counts
)

SELECT
    cohort_month,

    ROUND(
        MAX(
            CASE
                WHEN months_since_cohort = 0
                THEN active_customers * 100.0 / cohort_size
            END
        ), 2
    ) AS M0,

    ROUND(
        MAX(
            CASE
                WHEN months_since_cohort = 1
                THEN active_customers * 100.0 / cohort_size
            END
        ), 2
    ) AS M1,

    ROUND(
        MAX(
            CASE
                WHEN months_since_cohort = 2
                THEN active_customers * 100.0 / cohort_size
            END
        ), 2
    ) AS M2,

    ROUND(
        MAX(
            CASE
                WHEN months_since_cohort = 3
                THEN active_customers * 100.0 / cohort_size
            END
        ), 2
    ) AS M3,

    ROUND(
        MAX(
            CASE
                WHEN months_since_cohort = 4
                THEN active_customers * 100.0 / cohort_size
            END
        ), 2
    ) AS M4,

    ROUND(
        MAX(
            CASE
                WHEN months_since_cohort = 5
                THEN active_customers * 100.0 / cohort_size
            END
        ), 2
    ) AS M5,

    ROUND(
        MAX(
            CASE
                WHEN months_since_cohort = 6
                THEN active_customers * 100.0 / cohort_size
            END
        ), 2
    ) AS M6

FROM cohort_retention
GROUP BY cohort_month
ORDER BY cohort_month;


/*
============================================================
COHORT ANALYSIS — KEY INSIGHTS
============================================================

1. Month 0 retention is 100% for every cohort because it represents
   the customer's initial purchase month.

2. Retention drops sharply after the first month. M1 retention was
   generally below 1% across the major cohorts.

3. M1 retention varied across cohorts. Among the larger 2017 cohorts,
   M1 retention ranged approximately from 0.18% to 0.72%.

4. Later-month activity can fluctuate rather than continuously
   decrease because a customer can purchase in one month, become
   inactive, and return in a later month.

5. Recent cohorts have incomplete observation periods because the
   dataset ends in 2018. Therefore, newer cohorts should not be
   compared with older cohorts for long-term retention.

OVERALL CONCLUSION:
Customer retention was relatively low in the observed Olist dataset.
Only about 3% of customers made repeat purchases, and cohort analysis
shows that only a small percentage of customers remained active in
subsequent months.
============================================================
*/
